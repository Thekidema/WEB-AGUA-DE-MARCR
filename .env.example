PORT=3000
NODE_ENV=development

# Generar con: openssl rand -hex 32
JWT_SECRET=

ADMIN_USERNAME=admin
# Generar con: npm run create-admin
ADMIN_PASSWORD_HASH=

# Base de datos: sin TURSO_DATABASE_URL usa un archivo SQLite local (dev).
# En producción, setear estas dos y apunta a la base gestionada en Turso.
DB_PATH=./data/aguademar.sqlite
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Imágenes de productos: almacenadas en Cloudflare R2 (S3-compatible),
# nunca en disco local — Railway no persiste disco entre despliegues.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET_NAME=aguademar-productos
# URL pública del bucket (Public Development URL o dominio propio conectado)
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev
